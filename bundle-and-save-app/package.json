{
  "name": "bundle-and-save-app",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "remix dev",
    "build": "remix build && prisma generate",
    "start": "remix-serve build",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.4.2",
    "@remix-run/node": "^2.3.2",
    "@remix-run/react": "^2.3.2",
    "@remix-run/serve": "^2.3.2",
    "@shopify/app-bridge": "^3.7.10",
    "@shopify/app-bridge-react": "^3.7.10",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^2.8.0",
    "@shopify/shopify-app-session-storage-prisma": "^4.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.4",
    "winston": "^3.10.0",
    "decimal.js": "^10.4.3",
    "isbot": "^3.7.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.3.2",
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.25",
    "@types/react-dom": "^18.2.10",
    "prisma": "^5.4.2",
    "tsx": "^3.14.0",
    "typescript": "^5.2.2",
    "vitest": "^0.34.6",
    "@vitest/ui": "^0.34.6"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
